{
    "printWidth": 230,
    "tabWidth": 4,
    "trailingComma": "none",
    "plugins": ["prettier-plugin-astro", "prettier-plugin-astro-organize-imports", "prettier-plugin-tailwindcss"],
    "overrides": [
        {
            "files": "*.astro",
            "options": {
                "parser": "astro"
            }
        }
    ]
}
