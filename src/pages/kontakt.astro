---
import IconFacebook from "@icons/facebook.svg";
import IconInstagram from "@icons/instagram.svg";

import IconBank from "@icons/bank.svg";
import IconEnvelope from "@icons/envelope.svg";
import IconExclamationCircle from "@icons/exclamation-circle.svg";
import IconHandTap from "@icons/hand-tap.svg";
import IconLocationPin from "@icons/location-pin.svg";
import IconPhone from "@icons/phone.svg";
import IconTick from "@icons/tick.svg";

import FormInlineErrors from "@components/FormInlineErrors.astro";
import MapPopover from "@components/MapPopover.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout subtitle="Kontakt">
    <section class="top-level-container bg-muted/50 pt-28 pb-14 md:pt-38 md:pb-24">
        <div class="mx-auto max-w-6xl px-6">
            <div class="max-w-3xl">
                <p class="text-primary mb-4 text-sm font-medium tracking-wide uppercase">Kontakt</p>
                <h1 class="text-foreground mb-6 font-serif text-4xl font-semibold md:text-5xl">Chcesz dowiedzieć się więcej?</h1>
                <p class="text-muted-foreground text-xl leading-relaxed">Zapraszam do kontaktu – wspólnie znajdziemy Twoją drogę do&nbsp;zdrowia. Oferuję&nbsp;konsultacje w&nbsp;trybie stacjonarnym lub online.</p>
            </div>
        </div>
    </section>

    <section class="top-level-container py-12 md:py-24">
        <div class="mx-auto max-w-6xl px-6">
            <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
                <div class="space-y-8">
                    <div>
                        <h2 class="text-foreground mb-6 font-serif text-2xl font-semibold">Dane kontaktowe</h2>
                        <div class="space-y-6">
                            <div class="flex w-fit items-center gap-4">
                                <a href="mailto:kontakt@sylviadieta.pl" class="peer bg-muted fill-primary hover:bg-primary flex items-center justify-center rounded-lg p-2.5 transition hover:fill-white active:scale-95">
                                    <IconEnvelope class="size-7" />
                                </a>

                                <div class="peer-hover:[&>span]:text-primary">
                                    <p class="text-muted-foreground text-sm">E-mail</p>
                                    <span class="text-foreground font-medium transition-colors">kontakt@sylviadieta.pl</span>
                                </div>
                            </div>

                            <div class="flex w-fit items-center gap-4">
                                <a href="tel:+48501974479" class="peer bg-muted fill-primary hover:bg-primary flex items-center justify-center rounded-lg p-2.5 transition hover:fill-white active:scale-95">
                                    <IconPhone class="size-7" />
                                </a>

                                <div class="peer-hover:[&>span]:text-primary">
                                    <p class="text-muted-foreground text-sm">Telefon</p>
                                    <span class="text-foreground font-medium transition-colors">+48 501 974 479</span>
                                </div>
                            </div>

                            <div class="flex w-fit flex-col">
                                <div class="flex w-fit items-center gap-4">
                                    <button
                                        id="bank-account"
                                        data-account="26102010420000840203728599"
                                        class="peer bg-muted fill-primary hover:bg-primary flex cursor-pointer items-center justify-center rounded-lg p-2.5 transition hover:fill-white active:scale-95"
                                    >
                                        <IconBank class="size-7 -translate-y-px" />
                                    </button>

                                    <div class="peer-hover:[&>div>span]:text-primary text-left select-text">
                                        <p class="text-muted-foreground text-sm">Konto bankowe</p>
                                        <div class="relative inline-block font-medium">
                                            <span class="text-foreground block transition-colors">26 1020 1042 0000 8402 0372 8599</span>
                                            <span
                                                id="bank-account-copy-confirmation"
                                                class="text-success! fill-success pointer-events-none absolute inset-0 flex items-start gap-0.75 bg-white transition-[clip-path] duration-150 ease-linear [clip-path:inset(0_0_100%_0)]"
                                            >
                                                <IconTick class="mt-1 size-4" /> Skopiowano!
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div>
                        <h2 class="text-foreground mb-6 font-serif text-2xl font-semibold">Gabinety</h2>
                        <fieldset id="contact-map-locations" class="space-y-6">
                            <legend class="sr-only">Wybierz gabinet, aby zobaczyć mapę</legend>

                            <div class="relative flex items-start gap-4">
                                <label class="peer">
                                    <input
                                        type="radio"
                                        name="map-location"
                                        value="marki"
                                        data-map-src="https://maps.google.com/maps?width=600&height=400&hl=en&q=Poradnia%20Dietetyczna%2C%20Syl.VIA-Sylwia%20Majewska&t=&z=14&ie=UTF8&iwloc=B&output=embed"
                                        class="peer sr-only"
                                    />
                                    <div data-map-icon class="bg-muted fill-primary peer-checked:bg-primary hover:bg-primary cursor-pointer rounded-lg p-2.5 transition peer-checked:fill-white hover:fill-white active:scale-95">
                                        <IconLocationPin class="size-7" />
                                    </div>
                                </label>
                                <div class="peer-hover:[&>h3]:text-primary peer-has-checked:[&>h3]:text-primary">
                                    <h3 class="text-foreground font-medium transition-colors">Marki</h3>
                                    <p class="text-muted-foreground text-[15px]">ul. Słoneczna 3c/110, 05-270 Marki</p>
                                </div>
                                <IconHandTap aria-hidden="true" class="fill-foreground [&_path:last-child]:fill-foreground absolute -bottom-2 left-7.5 size-5 [&_path:first-child]:fill-white [&_path:first-child]:opacity-100" />
                            </div>

                            <div class="flex items-start gap-4">
                                <label class="peer">
                                    <input
                                        type="radio"
                                        name="map-location"
                                        value="zabki"
                                        data-map-src="https://maps.google.com/maps?width=600&height=400&hl=en&q=Blossom%20Pilates%20Studio%20Z%C4%85bki&t=&z=14&ie=UTF8&iwloc=B&output=embed"
                                        class="peer sr-only"
                                    />
                                    <div data-map-icon class="bg-muted fill-primary peer-checked:bg-primary hover:bg-primary cursor-pointer rounded-lg p-2.5 transition peer-checked:fill-white hover:fill-white active:scale-95">
                                        <IconLocationPin class="size-7" />
                                    </div>
                                </label>
                                <div class="peer-hover:[&>h3]:text-primary peer-has-checked:[&>h3]:text-primary">
                                    <h3 class="text-foreground font-medium transition-colors">Ząbki – Blossom Pilates Studio</h3>
                                    <p class="text-muted-foreground text-[15px]">ul. Orla 4/55, 05-091 Ząbki</p>
                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <div>
                        <h2 class="text-foreground mb-6 font-serif text-2xl font-semibold">Media społecznościowe</h2>
                        <div class="flex items-center gap-4">
                            <a
                                href="https://facebook.com/profile.php?id=100063849379058"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="bg-muted fill-primary hover:bg-primary flex items-center justify-center rounded-lg p-2 transition hover:fill-white active:scale-95"
                                aria-label="Facebook"><IconFacebook class="size-8" /></a
                            >
                            <a
                                href="https://instagram.com/syl.viadieta_"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="bg-muted fill-primary hover:bg-primary flex items-center justify-center rounded-lg p-2 transition hover:fill-white active:scale-95"
                                aria-label="Instagram"><IconInstagram class="size-8" /></a
                            >
                        </div>
                    </div>
                </div>

                <div>
                    <div class="bg-card border-border rounded-2xl border p-8 md:-mt-8.25 md:p-10">
                        <h2 class="text-foreground -mt-2 mb-6 font-serif text-2xl font-semibold">Napisz do mnie</h2>
                        <form id="contact-form" class="space-y-6" novalidate>
                            <div class="grid gap-6 sm:grid-cols-2">
                                <div data-field-wrapper>
                                    <label for="first-name" class="text-foreground mb-2 block text-sm font-medium">Imię</label>
                                    <div class="relative">
                                        <input
                                            type="text"
                                            id="first-name"
                                            name="first-name"
                                            class="peer bg-muted border-border text-foreground placeholder:text-muted-foreground focus:ring-primary/20 focus:border-primary aria-invalid:border-warning! aria-invalid:ring-warning/50! w-full rounded-lg border px-4 py-3 transition-colors focus:ring-2 focus:outline-none"
                                            placeholder="Anna"
                                            required
                                        />
                                        <IconExclamationCircle aria-hidden="true" class="stroke-warning absolute top-1/2 right-3 size-5 -translate-y-1/2 opacity-0 transition-opacity peer-aria-invalid:opacity-100" />
                                    </div>
                                </div>

                                <div data-field-wrapper>
                                    <label for="last-name" class="text-foreground mb-2 block text-sm font-medium">Nazwisko</label>
                                    <div class="relative">
                                        <input
                                            type="text"
                                            id="last-name"
                                            name="last-name"
                                            class="peer bg-muted border-border text-foreground placeholder:text-muted-foreground focus:ring-primary/20 focus:border-primary aria-invalid:border-warning! aria-invalid:ring-warning/50! w-full rounded-lg border px-4 py-3 transition-colors focus:ring-2 focus:outline-none"
                                            placeholder="Kowalska"
                                            required
                                        />
                                        <IconExclamationCircle aria-hidden="true" class="stroke-warning absolute top-1/2 right-3 size-5 -translate-y-1/2 opacity-0 transition-opacity peer-aria-invalid:opacity-100" />
                                    </div>
                                </div>
                            </div>

                            <div data-field-wrapper>
                                <label for="email" class="text-foreground mb-2 block text-sm font-medium">E-mail</label>
                                <div class="relative">
                                    <input
                                        type="email"
                                        id="email"
                                        name="email"
                                        class="peer bg-muted border-border text-foreground placeholder:text-muted-foreground focus:ring-primary/20 focus:border-primary aria-invalid:border-warning! aria-invalid:ring-warning/50! w-full rounded-lg border px-4 py-3 pr-10 transition-colors focus:ring-2 focus:outline-none"
                                        placeholder="annakowalska@poczta.pl"
                                        required
                                    />
                                    <IconExclamationCircle aria-hidden="true" class="stroke-warning absolute top-1/2 right-3 size-5 -translate-y-1/2 opacity-0 transition-opacity peer-aria-invalid:opacity-100" />
                                </div>
                            </div>

                            <div data-field-wrapper>
                                <label for="phone" class="text-foreground mb-2 block text-sm font-medium">Telefon (opcjonalnie)</label>
                                <div class="relative">
                                    <input
                                        type="tel"
                                        id="phone"
                                        name="phone"
                                        pattern="([+]48[ ]?)?[4-9][0-9]{2}[ ]?[0-9]{3}[ ]?[0-9]{3}"
                                        class="peer bg-muted border-border text-foreground placeholder:text-muted-foreground focus:ring-primary/20 focus:border-primary aria-invalid:border-warning! aria-invalid:ring-warning/50! w-full rounded-lg border px-4 py-3 pr-10 transition-colors focus:ring-2 focus:outline-none"
                                        placeholder="987 654 321"
                                    />
                                    <IconExclamationCircle aria-hidden="true" class="stroke-warning absolute top-1/2 right-3 size-5 -translate-y-1/2 opacity-0 transition-opacity peer-aria-invalid:opacity-100" />
                                </div>
                            </div>

                            <!-- TODO <div>
                                <label for="service" class="text-foreground mb-2 block text-sm font-medium">Interesująca usługa</label>
                                <select id="service" name="service" class="bg-muted border-border text-foreground focus:ring-primary/20 focus:border-primary w-full rounded-lg border px-4 py-3 transition-colors focus:ring-2 focus:outline-none" required>
                                    <option value="">Wybierz usługę</option>
                                    <option value="konsultacja-dietetyczna">Konsultacja dietetyczna</option>
                                    <option value="psychodietetyka">Psychodietetyka</option>
                                    <option value="dietoterapia">Dietoterapia kliniczna</option>
                                    <option value="nordic-walking">Nordic walking</option>
                                    <option value="pakiet-vip">Pakiet VIP</option>
                                </select>
                            </div> -->

                            <div data-field-wrapper>
                                <label for="message" class="text-foreground mb-2 block text-sm font-medium">Wiadomość</label>
                                <div class="relative">
                                    <textarea
                                        id="message"
                                        name="message"
                                        rows="5"
                                        class="peer bg-muted border-border text-foreground placeholder:text-muted-foreground focus:ring-primary/20 focus:border-primary aria-invalid:border-warning! aria-invalid:ring-warning/50! block w-full resize-none rounded-lg border px-4 py-3 pr-10 transition-colors focus:ring-2 focus:outline-none"
                                        placeholder="Opowiedz o swoich celach zdrowotnych..."
                                        minlength="20"
                                        required></textarea>
                                    <IconExclamationCircle aria-hidden="true" class="stroke-warning absolute top-3 right-3 size-5 opacity-0 transition-opacity peer-aria-invalid:opacity-100" />
                                </div>
                            </div>

                            <button type="submit" class="bg-primary hover:bg-primary-dark w-full rounded-lg px-7 py-3.5 font-medium text-white transition-colors">Wyślij wiadomość</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <FormInlineErrors formId="contact-form" />
    <MapPopover inputSelector="#contact-map-locations input[name='map-location']" />
</BaseLayout>

<script>
    // initial/reset state — clipped from bottom (ready to reveal)
    const HIDDEN_BEFORE = "[clip-path:inset(0_0_100%_0)]";
    // fully visible
    const VISIBLE = "[clip-path:inset(0_0_0%_0)]";
    // exit state — clipped from top (wiped off downward)
    const HIDDEN_AFTER = "[clip-path:inset(100%_0_0%_0)]";

    const bankAccountButton = document.getElementById("bank-account") as HTMLButtonElement;
    const copyConfirmation = document.getElementById("bank-account-copy-confirmation") as HTMLSpanElement;
    const accountNumber = bankAccountButton.dataset.account || "";
    let copyTimeout: ReturnType<typeof setTimeout> | null = null;
    bankAccountButton.addEventListener("click", () => {
        navigator.clipboard.writeText(accountNumber).catch(() => {});

        copyConfirmation.classList.add("transition-none");
        copyConfirmation.classList.remove(HIDDEN_AFTER, VISIBLE);
        copyConfirmation.classList.add(HIDDEN_BEFORE);

        copyConfirmation.offsetHeight; // oxlint-disable-line no-unused-expressions

        copyConfirmation.classList.remove("transition-none");
        copyConfirmation.classList.remove(HIDDEN_BEFORE);
        copyConfirmation.classList.add(VISIBLE);

        if (copyTimeout) clearTimeout(copyTimeout);
        copyTimeout = setTimeout(() => {
            copyConfirmation.classList.add(HIDDEN_AFTER);
            copyConfirmation.classList.remove(VISIBLE);
            copyTimeout = null;
        }, 1500);
    });
</script>
