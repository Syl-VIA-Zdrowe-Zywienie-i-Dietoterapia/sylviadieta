---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout subtitle="Kontakt">
    <main class="pt-24">
        <!-- Hero Section -->
        <section class="bg-muted/50 py-16 md:py-24">
            <div class="mx-auto max-w-6xl px-6">
                <div class="max-w-3xl">
                    <p class="text-primary mb-4 text-sm font-medium tracking-wide uppercase">Kontakt</p>
                    <h1 class="text-foreground mb-6 font-serif text-4xl font-semibold md:text-5xl">Chcesz dowiedzieć się więcej?</h1>
                    <p class="text-muted-foreground text-xl leading-relaxed">Zapraszam do kontaktu — wspólnie znajdziemy Twoją drogę do zdrowia. Oferuję konsultacje w trybie stacjonarnym lub online.</p>
                </div>
            </div>
        </section>

        <!-- Contact Content -->
        <section class="py-16 md:py-24">
            <div class="mx-auto max-w-6xl px-6">
                <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
                    <!-- Contact Info -->
                    <div class="space-y-8">
                        <div>
                            <h2 class="text-foreground mb-6 font-serif text-2xl font-semibold">Dane kontaktowe</h2>
                            <div class="space-y-6">
                                <div class="flex items-center gap-4">
                                    <div class="bg-primary-light/50 text-primary flex h-12 w-12 items-center justify-center rounded-lg">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <p class="text-muted-foreground text-sm">Email</p>
                                        <a href="mailto:dietetyka.syl.via@gmail.com" class="text-foreground hover:text-primary font-medium transition-colors"> dietetyka.syl.via@gmail.com </a>
                                    </div>
                                </div>

                                <div class="flex items-center gap-4">
                                    <div class="bg-primary-light/50 text-primary flex h-12 w-12 items-center justify-center rounded-lg">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <p class="text-muted-foreground text-sm">Telefon</p>
                                        <a href="tel:+48501974479" class="text-foreground hover:text-primary font-medium transition-colors"> +48 501 974 479 </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Locations -->
                        <div>
                            <h2 class="text-foreground mb-6 font-serif text-2xl font-semibold">Gabinety</h2>
                            <div class="space-y-6">
                                <div class="bg-muted/50 rounded-xl p-6">
                                    <div class="flex items-start gap-4">
                                        <div class="bg-primary-light/50 text-primary flex h-10 w-10 shrink-0 items-center justify-center rounded-lg">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"></path>
                                            </svg>
                                        </div>
                                        <div>
                                            <p class="text-foreground font-medium">Marki</p>
                                            <p class="text-muted-foreground">ul. Słoneczna 3c/110</p>
                                            <p class="text-muted-foreground">05-270 Marki</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="bg-muted/50 rounded-xl p-6">
                                    <div class="flex items-start gap-4">
                                        <div class="bg-primary-light/50 text-primary flex h-10 w-10 shrink-0 items-center justify-center rounded-lg">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"></path>
                                            </svg>
                                        </div>
                                        <div>
                                            <p class="text-foreground font-medium">Ząbki — Blossom Pilates Studio</p>
                                            <p class="text-muted-foreground">ul. Orla 4/55</p>
                                            <p class="text-muted-foreground">05-091 Ząbki</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Social Links -->
                        <div>
                            <h2 class="text-foreground mb-6 font-serif text-2xl font-semibold">Media społecznościowe</h2>
                            <div class="flex items-center gap-4">
                                <a href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" class="bg-muted text-foreground hover:bg-primary flex h-12 w-12 items-center justify-center rounded-lg transition-colors hover:text-white" aria-label="Facebook">
                                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"></path>
                                    </svg>
                                </a>
                                <a href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" class="bg-muted text-foreground hover:bg-primary flex h-12 w-12 items-center justify-center rounded-lg transition-colors hover:text-white" aria-label="Instagram">
                                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path
                                            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                                        ></path>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Form -->
                    <div>
                        <div class="bg-card border-border rounded-2xl border p-8 md:p-10">
                            <h2 class="text-foreground mb-6 font-serif text-2xl font-semibold">Napisz do mnie</h2>
                            <form class="space-y-6">
                                <div class="grid gap-6 sm:grid-cols-2">
                                    <div>
                                        <label for="firstName" class="text-foreground mb-2 block text-sm font-medium">Imię</label>
                                        <input type="text" id="firstName" name="firstName" class="bg-muted border-border text-foreground placeholder:text-muted-foreground focus:ring-primary/20 focus:border-primary w-full rounded-lg border px-4 py-3 transition-colors focus:ring-2 focus:outline-none" placeholder="Anna" />
                                    </div>
                                    <div>
                                        <label for="lastName" class="text-foreground mb-2 block text-sm font-medium">Nazwisko</label>
                                        <input type="text" id="lastName" name="lastName" class="bg-muted border-border text-foreground placeholder:text-muted-foreground focus:ring-primary/20 focus:border-primary w-full rounded-lg border px-4 py-3 transition-colors focus:ring-2 focus:outline-none" placeholder="Kowalska" />
                                    </div>
                                </div>

                                <div>
                                    <label for="email" class="text-foreground mb-2 block text-sm font-medium">Email</label>
                                    <input type="email" id="email" name="email" class="bg-muted border-border text-foreground placeholder:text-muted-foreground focus:ring-primary/20 focus:border-primary w-full rounded-lg border px-4 py-3 transition-colors focus:ring-2 focus:outline-none" placeholder="anna@example.com" />
                                </div>

                                <div>
                                    <label for="phone" class="text-foreground mb-2 block text-sm font-medium">Telefon (opcjonalnie)</label>
                                    <input type="tel" id="phone" name="phone" class="bg-muted border-border text-foreground placeholder:text-muted-foreground focus:ring-primary/20 focus:border-primary w-full rounded-lg border px-4 py-3 transition-colors focus:ring-2 focus:outline-none" placeholder="+48 123 456 789" />
                                </div>

                                <div>
                                    <label for="service" class="text-foreground mb-2 block text-sm font-medium">Interesująca usługa</label>
                                    <select id="service" name="service" class="bg-muted border-border text-foreground focus:ring-primary/20 focus:border-primary w-full rounded-lg border px-4 py-3 transition-colors focus:ring-2 focus:outline-none">
                                        <option value="">Wybierz usługę</option>
                                        <option value="konsultacja">Konsultacja dietetyczna</option>
                                        <option value="psychodietetyka">Psychodietetyka</option>
                                        <option value="dietoterapia">Dietoterapia kliniczna</option>
                                        <option value="nordic-walking">Nordic Walking</option>
                                        <option value="pakiet-vip">Pakiet VIP</option>
                                    </select>
                                </div>

                                <div>
                                    <label for="message" class="text-foreground mb-2 block text-sm font-medium">Wiadomość</label>
                                    <textarea id="message" name="message" rows="5" class="bg-muted border-border text-foreground placeholder:text-muted-foreground focus:ring-primary/20 focus:border-primary w-full resize-none rounded-lg border px-4 py-3 transition-colors focus:ring-2 focus:outline-none" placeholder="Opowiedz o swoich celach zdrowotnych..."></textarea>
                                </div>

                                <button type="submit" class="bg-primary hover:bg-primary-dark w-full rounded-lg px-7 py-3.5 font-medium text-white transition-colors"> Wyślij wiadomość </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
