---
import MainLayout from "../../layouts/MainLayout.astro";
import Introduction from "./content/Introduction.astro";
import Occupation from "./content/Occupation.astro";
import Qualifications from "./content/Qualifications.astro";
import Values from "./content/Values.astro";
---

<MainLayout subtitle="O mnie">
    <main id="about" class="mt-34 flex-1 px-6 md:px-10">
        <div class="mx-auto max-w-6xl space-y-10">
            <h1 class="text-center text-4xl font-bold md:text-6xl">Sylwia Majewska — dietetyk i&nbsp;psychodietetyk</h1>

            <div class="flex flex-col gap-5 md:gap-2">
                <Introduction />
                <div class="hidden md:block">
                    <div class="divider"></div>
                    <div class="tabs tabs-lift w-full justify-center [&>.tab-content]:[--tabcontent-radius-ss:var(--radius-box)]">
                        <input class="tab pt-1! text-2xl font-semibold" type="radio" name="tabs-about" aria-label="Czym się zajmuję" checked />
                        <div id="tab-content" class="tab-content bg-base-100 border-base-300 p-8">
                            <Occupation />
                        </div>

                        <input class="tab pt-1! text-2xl font-semibold" type="radio" name="tabs-about" aria-label="Kwalifikacje" />
                        <div id="tab-content" class="tab-content bg-base-100 border-base-300 p-8">
                            <Qualifications />
                        </div>

                        <input class="tab pt-1! text-2xl font-semibold" type="radio" name="tabs-about" aria-label="Moje wartości" />
                        <div id="tab-content" class="tab-content bg-base-100 border-base-300 p-8">
                            <Values />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</MainLayout>
