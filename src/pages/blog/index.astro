---
import { Picture } from "astro:assets";
import pinnedPicture from "../../images/blog/pinned.jpg";

import MainLayout from "../../layouts/MainLayout.astro";
import YearMonthPicker from "../../components/YearMonthPicker.astro";
import KeywordPicker from "../../components/KeywordPicker.astro";

const content = import.meta.glob<{ frontmatter: Record<string, any>; Content: any }>("./content/*.md", { eager: true });
const posts = Object.values(content)
    .filter((post) => post.frontmatter.date)
    .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

const availableYears = [...new Set(posts.map((post) => new Date(post.frontmatter.date).getFullYear()))].sort();

const allKeywords = [...new Set(posts.flatMap((post) => post.frontmatter.keywords ?? []))].sort((a, b) => a.localeCompare(b, "pl"));
---

<MainLayout subtitle="Z gabinetu psychodietetyka">
    <main id="blog" class="mt-34 flex-1 px-6 md:px-10">
        <div class="mx-auto flex max-w-6xl flex-col gap-1 md:flex-row md:gap-10">
            <div id="blog-sidebar" class="max-w-xs space-y-6 md:sticky md:self-start">
                <div class="card bg-base-100 border-base-300 border shadow-lg">
                    <div class="card-body">
                        <article class="prose prose-picture:mb-0 text-[0.925rem] max-w-none">
                            <Picture src={pinnedPicture} formats={["avif"]} alt="Mój wizerunek" loading="eager" fetchpriority="high" class="rounded-md shadow-sm" />
                            <p>Psychodietetyka łączy wiedzę z psychologii i dietetyki, by pomóc zrozumieć, dlaczego mamy trudności z jedzeniem, i jak je skutecznie pokonać. Na blogu <em>„Z gabinetu psychodietetyka”</em> pokażę Ci, jak krok po kroku budować zdrową relację z jedzeniem — bez presji, lęku i frustracji.</p>
                            <p>Nie opisuję historii konkretnych osób, tylko problemy, z którymi zgłaszają się do mnie Pacjenci. Opowiadam o różnych sytuacjach, żeby pokazać, że wiele osób mierzy się z podobnymi wyzwaniami i nie jesteśmy w nich sami.</p>
                            <p>Ten blog jest miejscem wsparcia i zrozumienia dla każdego, kto chce zmienić swoje nawyki w sposób przyjazny i skuteczny. Zapraszam do śledzenia kolejnych wpisów, w których dzielę się moją wiedzą.</p>
                            <p>Wszelkie podobieństwo do rzeczywistych osób i zdarzeń jest przypadkowe.</p>
                        </article>
                    </div>
                </div>
                <div class="hidden md:block">
                    <YearMonthPicker availableYears={availableYears} />
                </div>
                <div class="hidden md:block">
                    <KeywordPicker allKeywords={allKeywords} />
                </div>
            </div>

            <div class="divider md:hidden"></div>

            <div class="space-y-6 md:space-y-10">
                {posts.map((post) => {
                    const date = new Date(post.frontmatter.date);
                    return (
                        <div data-post-year={date.getFullYear()} data-post-month={date.getMonth() + 1} data-keywords={JSON.stringify(post.frontmatter.keywords ?? [])}>
                            <post.Content />
                        </div>
                    );
                })}
            </div>
        </div>
    </main>
</MainLayout>

<script>
    const blogSidebar = document.getElementById("blog-sidebar")!;
    const md = window.matchMedia("(min-width: 768px)");

    function adjustSidebar() {
        if (!md.matches) {
            blogSidebar.style.top = "";
            return;
        }
        const viewportHeight = window.innerHeight;
        const sidebarHeight = blogSidebar.offsetHeight;
        const topGap = 136;
        const bottomGap = 40;
        blogSidebar.style.top =
            sidebarHeight + topGap + bottomGap > viewportHeight
                ? `${viewportHeight - sidebarHeight - bottomGap}px`
                : `${topGap}px`;
    }

    adjustSidebar();
    window.addEventListener("resize", adjustSidebar);
</script>
