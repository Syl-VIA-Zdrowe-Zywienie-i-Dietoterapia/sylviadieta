---
import PreparationGuideDrawer from "@components/preparation-guide/Drawer.astro";
import PreparationGuideSidebar from "@components/preparation-guide/Sidebar.astro";

import IconArrowDown from "@icons/arrow-down.svg";
import IconTick from "@icons/tick.svg";
import IconDollarCircle from "@icons/dollar-circle.svg";
import IconGroup from "@icons/group.svg";
import IconPersonHiking from "@icons/person-hiking.svg";
import IconQuestionCircle from "@icons/question-circle.svg";
import IconScale from "@icons/scale.svg";
import IconDiamond from "@icons/diamond.svg";

import BaseLayout from "@layouts/BaseLayout.astro";

const serviceCategories = [
    { id: "psychodietetyka", title: "Psychodietetyka", subtitle: "Konsultacje i jadłospisy", icon: IconScale },
    { id: "nordic-walking", title: "Nordic Walking", subtitle: "Zajęcia grupowe i indywidualne", icon: IconPersonHiking },
    { id: "warsztaty-i-wyjazdy", title: "Warsztaty i wyjazdy", subtitle: "Edukacja i integracja", icon: IconGroup }
];

const psychodietetykaPricing = [
    { service: "Pierwsza konsultacja dietetyczna z elementami psychodietetyki", duration: "60–80 min", price: "260 zł" },
    { service: "Konsultacja psychodietetyczna", duration: "60–80 min", price: "200 zł" },
    { service: "Jadłospis 7-dniowy", duration: "—", price: "250 zł" },
    { service: "Jadłospis 14-dniowy", duration: "—", price: "460 zł" },
    { service: "Wizyta kontrolna — dietetyczna", duration: "40–60 min", price: "170 zł" },
    { service: "Profesjonalna analiza składu ciała z omówieniem wyników", duration: "—", price: "60 zł" },
    { service: "Modyfikacja jadłospisu — wprowadzenie powyżej 4 zmian", duration: "—", price: "80 zł" },
    { service: "Pakiet VIP", duration: "3 miesiące", price: "1500 zł" }
];

const paraPricing = [
    { service: "Pierwsza wizyta dla pary", duration: "ok. 120 min", price: "450 zł" },
    { service: "Plan dietetyczny dla par 7-dniowy", duration: "—", price: "450 zł" }
];

const nordicPricing = [
    { service: "Zajęcia indywidualne", duration: "1,5 godz.", price: "150 zł" },
    { service: "Zajęcia dla 2 osób", duration: "1,5 godz.", price: "90 zł / osoba" },
    { service: "Zajęcia grupowe (3–4 osoby)", duration: "1,5 godz.", price: "60 zł / osoba" },
    { service: "Zajęcia grupowe (5–8 osób)", duration: "1,5 godz.", price: "90 zł / osoba" },
    { service: "Pakiet indywidualnych spotkań treningowych", duration: "3 × 1 godz.", price: "400 zł" },
    { service: "Zniżka dla organizatora grupy (powyżej 4 osób)", duration: "—", price: "50% zniżki" },
    { service: "Wypożyczenie kijków do nordic walking", duration: "—", price: "bezpłatne" }
];

const warsztatyPricing = [
    { service: "Warsztaty „Świadome Odżywianie” (maks. 20 osób)", duration: "2 godz.", price: "250 zł" },
    { service: "Szkolenie „Zdrowy Start” dla dzieci szkolnych", duration: "1,5 godz.", price: "200 zł" }
];
---

<BaseLayout subtitle="Usługi">
    <section class="bg-muted/50 pt-28 pb-14 md:pt-38 md:pb-18">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mb-12 max-w-4xl">
                <p class="text-primary mb-4 text-sm font-medium tracking-wide uppercase">Usługi</p>
                <h1 class="text-foreground mb-6 font-serif text-4xl font-semibold md:text-5xl">Kompleksowe wsparcie żywieniowe</h1>
                <p class="text-muted-foreground text-xl leading-relaxed">Holistyczne podejście do zdrowia, które łączy żywienie, psychologię i&nbsp;aktywność fizyczną dla&nbsp;pełnego dobrostanu.</p>
            </div>

            <div class="grid gap-4 md:grid-cols-3">
                {
                    serviceCategories.map((serviceCategory) => (
                        <a
                            href={`#${serviceCategory.id}`}
                            class="group bg-card border-border hover:border-primary/50 focus-visible:ring-primary flex items-center gap-4 rounded-xl border p-4 transition hover:shadow-sm focus-visible:ring-2 focus-visible:outline-none active:scale-97"
                        >
                            <div class="bg-primary/10 group-hover:bg-primary fill-primary flex items-center justify-center rounded-lg p-3 transition-colors group-hover:fill-white">
                                <serviceCategory.icon class="size-6" />
                            </div>
                            <div class="-mt-0.75 grow">
                                <h3 class="text-foreground group-hover:text-primary font-serif text-lg font-medium transition-colors">{serviceCategory.title}</h3>
                                <p class="text-muted-foreground text-sm">{serviceCategory.subtitle}</p>
                            </div>
                            <IconArrowDown class="text-muted-foreground group-hover:text-primary mr-1 size-5 transition-colors" />
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section id="psychodietetyka" class="scroll-mt-24 py-16 md:py-24">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mb-8 space-y-4">
                <div class="flex grow items-center gap-4">
                    <div class="bg-primary/10 fill-primary flex items-center justify-center rounded-xl p-3.5">
                        <IconScale class="size-7" />
                    </div>
                    <div>
                        <h2 class="text-foreground font-serif text-3xl font-semibold md:text-4xl">Psychodietetyka</h2>
                        <p class="text-muted-foreground">Konsultacje, jadłospisy i wsparcie psychodietetyczne</p>
                    </div>
                </div>

                <div class="flex gap-2">
                    <a
                        href="#cennik-psychodietetyka"
                        class="text-muted-foreground hover:bg-primary focus-visible:ring-primary bg-primary/10 border-border flex items-center rounded-full border px-0.75 py-px text-sm font-medium shadow-xs transition hover:text-white focus-visible:ring-2 focus-visible:outline-none active:scale-95"
                    >
                        <IconDollarCircle class="size-5" />
                        <span class="-mt-px px-1">Cennik</span>
                    </a>
                    <button
                        id="preparation-guide-toggle"
                        class="text-muted-foreground hover:bg-primary focus-visible:ring-primary bg-primary/10 border-border flex w-fit cursor-pointer items-center rounded-full border px-0.75 py-px text-sm font-medium shadow-xs transition hover:text-white focus-visible:ring-2 focus-visible:outline-none active:scale-95"
                        aria-expanded="false"
                        aria-controls="preparation-guide-sidebar"
                    >
                        <IconQuestionCircle class="size-5" />
                        <span class="-mt-px px-1">Przygotowanie do wizyty</span>
                    </button>
                </div>
            </div>

            <div class="mb-16">
                <h3 class="text-foreground mb-6 font-serif text-2xl font-semibold">Pierwsza konsultacja dietetyczna z elementami psychodietetyki</h3>
                <div class="grid items-start gap-8 md:grid-cols-3">
                    <div class="space-y-4 md:col-span-2">
                        <p class="text-muted-foreground leading-relaxed">
                            Zebranie informacji dotyczących preferencji żywieniowych, stanu zdrowia, wcześniej stosowanych diet, planu dnia oraz aktywności fizycznej. Szczegółowy wywiad pozwalający poznać Twoje nawyki i potrzeby.
                        </p>
                        <ul class="space-y-3">
                            {
                                [
                                    "Wywiad psychodietetyczny — analiza Twoich przekonań i\u00A0zachowań związanych z\u00A0jedzeniem",
                                    "Interpretacja wyników badań laboratoryjnych (morfologia, glukoza, profil lipidowy)",
                                    "Analiza dotychczasowego sposobu odżywiania oraz nawyków żywieniowych",
                                    "Pomiar i\u00A0analiza składu ciała przy użyciu analizatora InBody 120"
                                ].map((item) => (
                                    <li class="flex items-start gap-3">
                                        <span class="bg-primary/10 fill-primary mt-px flex items-center justify-center rounded-full p-1">
                                            <IconTick class="size-3.75" />
                                        </span>
                                        <p class="text-muted-foreground">{item}</p>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                    <div class="bg-muted/50 rounded-xl p-6">
                        <h4 class="text-foreground mb-4 font-medium">Analiza składu ciała obejmuje m.in.:</h4>
                        <ul class="text-muted-foreground space-y-2">
                            <li>• ilość wody komórkowej</li>
                            <li>• podstawową przemianę materii</li>
                            <li>• zawartość tkanki tłuszczowej, masy kostnej i mięśniowej</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="mb-16">
                <h3 class="text-foreground mb-6 font-serif text-2xl font-semibold">Jadłospis</h3>
                <p class="text-muted-foreground mb-6 leading-relaxed">
                    Jako rezultat pracy dietetyka po pierwszej wizycie powstaje jadłospis — indywidualny plan żywieniowy na tydzień lub dwa tygodnie, uwzględniający Twój stan zdrowia i styl życia.
                </p>
                <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
                    {
                        [
                            { title: "Dostosowany do stylu życia", description: "Uwzględnia umiejętności kulinarne, dostępny czas oraz budżet" },
                            { title: "Preferencje smakowe", description: "Dieta dopasowana do Twoich ulubionych smaków" },
                            { title: "Dostawa jadłospisu", description: "Mailowo lub w formie drukowanej w teczce" },
                            { title: "Aplikacja dietetyczna", description: "Pełen dostęp do planu, przepisów i list zakupów" }
                        ].map((item) => (
                            <div class="bg-card border-border rounded-xl border p-5 transition-shadow hover:shadow-sm">
                                <h4 class="text-foreground mb-2 font-medium">{item.title}</h4>
                                <p class="text-muted-foreground text-sm">{item.description}</p>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="mb-16">
                <h3 class="text-foreground mb-6 font-serif text-2xl font-semibold">Konsultacja psychodietetyczna</h3>
                <p class="text-muted-foreground mb-6 leading-relaxed">
                    W swojej pracy łączę wiedzę z zakresu dietetyki i psychologii, by towarzyszyć Ci w budowaniu bardziej życzliwej i zdrowej relacji z jedzeniem oraz z samym sobą. Konsultacja obejmuje materiały edukacyjne i
                    ćwiczenia wspierające Twój proces zmiany.
                </p>
                <div class="bg-primary/5 border-primary/10 rounded-xl border p-6">
                    <h4 class="text-foreground mb-4 font-medium">Dla kogo są konsultacje psychodietetyczne?</h4>
                    <p class="text-muted-foreground mb-4">Zapraszam osoby, które:</p>
                    <ul class="grid gap-3 md:grid-cols-2">
                        {
                            [
                                "zmagają się z zaburzeniami odżywiania (anoreksja, bulimia, kompulsywne objadanie się)",
                                "doświadczają trudności w relacji z jedzeniem i własnym ciałem",
                                "mierzą się z napadami objadania się lub nadmiernymi restrykcjami",
                                "odczuwają poczucie winy po jedzeniu lub lęk związany z przybieraniem na wadze",
                                "pragną odzyskać spokój, poczucie kontroli i zdrową relację z jedzeniem",
                                "są w trakcie terapii i potrzebują dodatkowego wsparcia żywieniowego"
                            ].map((item) => (
                                <li class="flex items-start gap-3">
                                    <span class="bg-primary/10 text-primary mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3 w-3" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                        </svg>
                                    </span>
                                    <span class="text-muted-foreground text-sm">{item}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>

            <div class="group bg-primary-dark mb-16 rounded-2xl p-8 text-white transition hover:shadow-lg md:p-10">
                <div class="grid gap-8 lg:grid-cols-2">
                    <div class="space-y-6">
                        <div class="flex gap-3.5">
                            <div class="group-hover:bg-primary mt-1 flex items-center justify-center rounded-xl bg-white/20 fill-white p-3 transition">
                                <IconDiamond class="size-8" />
                            </div>
                            <div class="flex flex-col items-start gap-1">
                                <h3 class="font-serif text-2xl font-semibold md:text-3xl">Pakiet VIP</h3>
                                <p class="text-primary-light text-sm font-medium tracking-wide uppercase">3 miesiące kompleksowego wsparcia</p>
                            </div>
                        </div>
                        <p class="leading-relaxed text-white/80">Regularna, zaplanowana współpraca oparta na Twoich indywidualnych potrzebach.</p>
                        <div class="flex items-baseline gap-2">
                            <span class="font-serif text-3xl font-bold">1500 zł</span>
                            <span class="text-white/60">/ 3 miesiące</span>
                        </div>
                    </div>
                    <ul class="space-y-3">
                        {
                            [
                                "Konsultacja wstępna (90 min)",
                                "6 spotkań indywidualnych (50–60 min) co 1–2 tygodnie",
                                "2 × indywidualny jadłospis na 14 dni",
                                "Stały kontakt mailowy lub wiadomościowy",
                                "Materiały wspierające: ćwiczenia, dzienniki, wskazówki",
                                "Elastyczny grafik i pierwszeństwo w umawianiu wizyt"
                            ].map((item) => (
                                <li class="flex items-start gap-3">
                                    <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-white/20 text-white">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3 w-3" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                        </svg>
                                    </span>
                                    <span class="text-white/90">{item}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>

            <div id="cennik-psychodietetyka" class="scroll-mt-24">
                <h3 class="text-foreground mb-6 font-serif text-2xl font-semibold">Cennik — Psychodietetyka</h3>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="border-border border-b">
                                <th class="text-foreground px-4 py-4 text-left font-medium">Usługa</th>
                                <th class="text-foreground px-4 py-4 text-left font-medium">Czas</th>
                                <th class="text-foreground px-4 py-4 text-right font-medium">Cena</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                psychodietetykaPricing.map((item, i) => (
                                    <tr class={`border-border/50 border-b ${i % 2 === 0 ? "bg-muted/30" : ""}`}>
                                        <td class="text-muted-foreground px-4 py-4">{item.service}</td>
                                        <td class="text-muted-foreground px-4 py-4">{item.duration}</td>
                                        <td class="text-foreground px-4 py-4 text-right font-medium">{item.price}</td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>

                <h4 class="text-foreground mt-10 mb-4 font-serif text-xl font-semibold">Dla par</h4>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="border-border border-b">
                                <th class="text-foreground px-4 py-4 text-left font-medium">Usługa</th>
                                <th class="text-foreground px-4 py-4 text-left font-medium">Czas</th>
                                <th class="text-foreground px-4 py-4 text-right font-medium">Cena</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                paraPricing.map((item, i) => (
                                    <tr class={`border-border/50 border-b ${i % 2 === 0 ? "bg-muted/30" : ""}`}>
                                        <td class="text-muted-foreground px-4 py-4">{item.service}</td>
                                        <td class="text-muted-foreground px-4 py-4">{item.duration}</td>
                                        <td class="text-foreground px-4 py-4 text-right font-medium">{item.price}</td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <section id="nordic-walking" class="bg-muted/50 scroll-mt-24 py-16 md:py-24">
        <div class="mx-auto max-w-6xl px-6">
            <div class="mb-16 grid gap-12 lg:grid-cols-2">
                <div>
                    <div class="mb-7 space-y-2 sm:space-y-4">
                        <div class="flex items-center gap-4">
                            <div class="bg-primary/10 fill-primary flex items-center justify-center rounded-xl p-3.5">
                                <IconPersonHiking class="size-7" />
                            </div>
                            <div>
                                <h2 class="text-foreground font-serif text-3xl font-semibold md:text-4xl">Nordic Walking</h2>
                                <p class="text-muted-foreground">Zajęcia grupowe i&nbsp;indywidualne z&nbsp;certyfikowanym instruktorem</p>
                            </div>
                        </div>

                        <a
                            href="#cennik-nordic-walking"
                            class="text-muted-foreground hover:bg-primary focus-visible:ring-primary bg-primary/10 border-border flex w-fit items-center rounded-full border px-0.75 py-px text-sm font-medium shadow-xs transition hover:text-white focus-visible:ring-2 focus-visible:outline-none active:scale-95 md:hidden"
                        >
                            <IconDollarCircle class="size-5" />
                            <span class="-mt-px px-1">Cennik</span>
                        </a>
                    </div>
                    <div>
                        <p class="text-muted-foreground mb-6 text-lg leading-relaxed">Nordic walking to najlepsza aktywność fizyczna na świecie! To niepozorne, aktywne chodzenie z kijami ma same zalety:</p>
                        <ul class="grid grid-cols-2 gap-3">
                            {
                                [
                                    "zmniejsza obciążenie stawów o\u00A030%",
                                    "wspomaga układ odpornościowy",
                                    "wspomaga układ krążenia i\u00A0oddechowy",
                                    "zmniejsza ryzyko osteoporozy",
                                    "zmniejsza ryzyko cukrzycy i\u00A0nowotworów",
                                    "redukuje stres i\u00A0poprawia nastrój",
                                    "wspomaga pracę układu hormonalnego",
                                    "wspomaga proces odchudzania",
                                    "wzmacnia mięśnie"
                                ].map((item) => (
                                    <li class="flex items-start gap-2">
                                        <span class="bg-primary/10 text-primary mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3 w-3" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                            </svg>
                                        </span>
                                        <span class="text-muted-foreground">{item}</span>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>

                <div class="bg-card border-border rounded-2xl border p-8 transition-shadow hover:shadow-sm">
                    <h3 class="text-foreground mb-6 font-serif text-xl font-semibold">Co zyskasz na zajęciach?</h3>
                    <ul class="space-y-4">
                        {
                            [
                                "Dowiesz się, jak prawidłowo dobrać kijki",
                                "Opanujesz technikę aktywnego chodzenia z\u00A0kijkami krok po kroku",
                                "Nauczysz się angażować mięśnie górnej części ciała w\u00A0optymalny sposób",
                                "Wzmocnisz i\u00A0rozciągniesz ciało",
                                "Dotlenisz organizm i\u00A0poprawisz zdrowie",
                                "Spędzisz czas aktywnie, w\u00A0świetnej atmosferze!"
                            ].map((item, i) => (
                                <li class="flex items-start gap-4">
                                    <span class="bg-primary flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg text-sm font-medium text-white">{i + 1}</span>
                                    <span class="text-muted-foreground pt-1">{item}</span>
                                </li>
                            ))
                        }
                    </ul>
                    <p class="text-muted-foreground bg-muted/50 mt-6 rounded-lg p-4 text-sm">
                        Nie musisz od razu kupować kijków do nordic walking. Możesz je <strong class="text-foreground">bezpłatnie wypożyczyć</strong> na zajęciach, by przetestować ten sport.
                    </p>
                </div>
            </div>

            <!-- Pricing Table -->
            <div id="cennik-nordic-walking" class="scroll-mt-24">
                <h3 class="text-foreground mb-6 font-serif text-2xl font-semibold">Cennik — Nordic Walking</h3>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="border-border border-b">
                                <th class="text-foreground px-4 py-4 text-left font-medium">Zajęcia</th>
                                <th class="text-foreground px-4 py-4 text-left font-medium">Czas</th>
                                <th class="text-foreground px-4 py-4 text-right font-medium">Cena</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                nordicPricing.map((item, i) => (
                                    <tr class={`border-border/50 border-b ${i % 2 === 0 ? "bg-card" : ""}`}>
                                        <td class="text-muted-foreground px-4 py-4">{item.service}</td>
                                        <td class="text-muted-foreground px-4 py-4">{item.duration}</td>
                                        <td class="text-foreground px-4 py-4 text-right font-medium">{item.price}</td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 3: Warsztaty i wyjazdy -->
    <section id="warsztaty-i-wyjazdy" class="scroll-mt-24 py-16 md:py-24">
        <div class="mx-auto max-w-6xl px-6">
            <div class="xs:space-y-4 mb-7 space-y-2">
                <div class="flex items-center gap-4">
                    <div class="bg-primary/10 fill-primary flex items-center justify-center rounded-xl p-3.5">
                        <IconGroup class="size-7" />
                    </div>
                    <div>
                        <h2 class="text-foreground font-serif text-3xl font-semibold md:text-4xl">Warsztaty i wyjazdy</h2>
                        <p class="text-muted-foreground">Edukacja żywieniowa i&nbsp;aktywny wypoczynek</p>
                    </div>
                </div>

                <a
