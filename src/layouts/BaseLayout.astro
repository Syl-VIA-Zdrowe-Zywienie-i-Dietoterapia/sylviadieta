---
import { Font } from "astro:assets";

import "../styles/global.css";
// import Meta from "../components/Meta.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ScrollToTop from "../components/ScrollToTop.astro";

interface Props {
    subtitle?: string;
    description?: string;
}

const {
    subtitle = "",
    description = "Profesjonalna pomoc dietetyczna i psychodietetyczna. Sylwia Majewska – dietetyk, psychodietetyk. Indywidualne plany żywieniowe, konsultacje online, stacjonarne.",
} = Astro.props;
---

<html lang="pl" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <meta name="description" content={description} />
        <meta name="author" content="Sylwia Majewska" />

        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
        <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

        <Font cssVariable="--font-inter" preload />
        <Font cssVariable="--font-playfair" preload />
        <title>{subtitle ? `${subtitle} | ` : ""}Syl.VIA – Zdrowe Żywienie i Dietoterapia</title>
    </head>

    <body class="flex min-h-screen flex-col antialiased">
        <Header />
        <main class="grow flex flex-col">
            <slot />
        </main>
        <Footer />
        <ScrollToTop />
    </body>
</html>
