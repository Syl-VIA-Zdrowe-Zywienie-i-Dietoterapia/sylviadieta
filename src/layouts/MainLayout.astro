---
import "@fortawesome/fontawesome-free/css/fontawesome.css";
import "@fortawesome/fontawesome-free/css/solid.css";
import "@fortawesome/fontawesome-free/css/brands.css";
import "@fontsource-variable/source-sans-3";
import "../styles/global.css";
import Meta from "../components/Meta.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    subtitle: string;
}

const { subtitle } = Astro.props;
---

<html lang="pl" data-theme="light" class="scroll-smooth">
    <head>
        <Meta />
        <link rel="icon" type="image/x-icon" href="/favicon.png" />
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
        <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
        <title>Syl.VIA — Zdrowe Żywienie i Dietoterapia | {subtitle}</title>
    </head>

    <body class="bg-base-200 relative flex min-h-screen flex-col text-base md:text-lg">
        <Header />
        <slot />
        <Footer />
    </body>
</html>
