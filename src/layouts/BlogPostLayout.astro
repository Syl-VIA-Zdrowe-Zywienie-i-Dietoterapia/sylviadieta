---
const { frontmatter } = Astro.props;

const formattedDate = new Date(frontmatter.date).toLocaleDateString("pl-PL", {
    year: "numeric",
    month: "long",
    day: "numeric",
});

const modalId = `post_${frontmatter.date.split("T")[0].replace(/-/g, "_")}`;
---


<div class="card bg-base-100 border-base-300 cursor-pointer border shadow-lg md:col-span-5" onclick={`${modalId}.showModal()`}>
    <div class="card-body">
        <article class="prose max-w-none">
            <h2>{frontmatter.title}</h2>
            <p>{frontmatter.description}</p>
            <h4>Czytaj dalej...</h4>
        </article>
        <p class="absolute right-0 bottom-0 pr-4 pb-3 text-sm text-gray-500">Opublikowano: {formattedDate}</p>
    </div>
</div>

<dialog id={modalId} class="modal px-4">
    <div class="modal-box max-h-5/6 max-w-2xl md:max-h-11/12">
        <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute top-2 right-2"><i class="fas fa-xmark"></i></button>
        </form>
        <article class="prose prose-li:mt-1 prose-li:mb-1 prose-ul:md:list-inside prose-ol:md:list-inside prose-p:has-[+ol,+ul]:mb-0 prose-blockquote:[quotes:''_''] prose-blockquote:font-normal max-w-none *:mt-1">
            <slot />
        </article>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>
