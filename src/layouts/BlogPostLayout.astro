---
const { frontmatter } = Astro.props;

const formattedDate = new Date(frontmatter.date).toLocaleDateString("pl-PL", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
---

<div class="blog-card card bg-base-100 border-base-300 scroll-mt-32 border shadow-lg md:col-span-5" data-expanded="false">
    <div class="card-body overflow-hidden">
        <div class="blog-card-inner transition-[height] duration-300 ease-in-out">
            <!-- collapsed preview -->
            <article class="blog-card-preview prose max-w-none">
                <h1 class="text-3xl">{frontmatter.title}</h1>
                <p>{frontmatter.description}</p>
                <button class="blog-card-expand text-neutral mx-auto -mt-4 -mb-3 block w-fit cursor-pointer px-3 py-2 font-semibold">Czytaj dalej <i class="fas fa-chevron-down text-sm"></i></button>
            </article>

            <!-- expanded full content -->
            <article class="blog-card-content prose prose-h1:text-3xl prose-h1:mt-0 prose-li:mt-1 prose-li:mb-1 prose-ul:md:list-inside prose-ol:md:list-inside prose-p:has-[+ol,+ul]:mb-0 prose-blockquote:[quotes:''_''] prose-blockquote:font-normal hidden max-w-none *:mt-1">
                <slot />
                <button class="blog-card-collapse text-neutral mx-auto -mt-4 -mb-3 block w-fit cursor-pointer px-3 py-2 font-semibold">Zwiń <i class="fas fa-chevron-up text-sm"></i></button>
            </article>
        </div>

        <p class="absolute right-0 bottom-0 pr-4 pb-3 text-sm text-gray-500">Opublikowano: {formattedDate}</p>
    </div>
</div>

<script>
    document.querySelectorAll<HTMLElement>(".blog-card").forEach((card) => {
        const expandBtn = card.querySelector<HTMLElement>(".blog-card-expand")!;
        const collapseBtn = card.querySelector<HTMLElement>(".blog-card-collapse")!;

        function toggle() {
            const expanded = card.dataset.expanded === "true";
            const preview = card.querySelector(".blog-card-preview")!;
            const content = card.querySelector(".blog-card-content")!;

            if (expanded) {
                const wasScrolledPast = card.getBoundingClientRect().top < 0;
                const scrollMargin = +getComputedStyle(card).scrollMarginTop || 0;
                const targetY = card.offsetTop - scrollMargin;

                content.classList.add("hidden");
                preview.classList.remove("hidden");
                card.dataset.expanded = "false";

                if (wasScrolledPast) {
                    const belowCard = targetY + card.offsetHeight;
                    if (window.scrollY < belowCard) {
                        window.scrollTo({ top: belowCard, behavior: "instant" });
                    }
                    card.scrollIntoView({ behavior: "smooth", block: "start" });
                }
            } else {
                preview.classList.add("hidden");
                content.classList.remove("hidden");
                card.dataset.expanded = "true";
            }
        }

        expandBtn.addEventListener("click", toggle);
        collapseBtn.addEventListener("click", toggle);
    });
</script>
