---
import { Picture } from "astro:assets";

import IconFacebook from "@icons/facebook.svg";
import IconInstagram from "@icons/instagram.svg";

import LogoHorizontalBigTextWhite80 from "@logos/horizontal-big-text/logo-horizontal-big-text-white80.png";
---

<footer class="top-level-container bg-foreground py-8 text-white/80">
    <div class="mx-auto max-w-6xl px-6">
        <div class="mb-2 flex flex-col justify-between gap-8 md:flex-row">
            <div class="flex flex-col items-center gap-4 md:items-start">
                <p class="text-center text-sm leading-relaxed md:text-left">
                    &copy; {new Date().getFullYear()} Syl.VIA – Zdrowe Żywienie i Dietoterapia <br />
                    Wszelkie prawa zastrzeżone. NIP:&nbsp;8121699322
                </p>
                <div class="flex items-center gap-6">
                    <a href="/">
                        <Picture src={LogoHorizontalBigTextWhite80} formats={["avif"]} alt="Logo poradni Syl.VIA" class="h-auto w-48" />
                    </a>
                    <span class="flex items-center gap-4">
                        <a
                            href="https://facebook.com/profile.php?id=100063849379058"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:bg-primary flex items-center justify-center rounded-full bg-white/10 fill-current p-2 transition hover:fill-white active:scale-95"
                            aria-label="Facebook"><IconFacebook class="size-6" /></a
                        >
                        <a
                            href="https://instagram.com/syl.viadieta_"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:bg-primary flex items-center justify-center rounded-full bg-white/10 fill-current p-2 transition hover:fill-white active:scale-95"
                            aria-label="Instagram"><IconInstagram class="size-6" /></a
                        >
                    </span>
                </div>
            </div>

            <div class="flex grow flex-col items-center md:max-w-60 md:items-start">
                <h4 class="mb-4 font-serif text-lg font-medium text-white">Informacje</h4>
                <ul class="space-y-3 text-center text-sm md:text-left">
                    <li><a href="/regulamin.pdf" target="_blank" class="hover:text-primary transition-colors">Regulamin świadczenia usług</a></li>
                    <li><a href="/polityka-prywatnosci.pdf" target="_blank" class="hover:text-primary transition-colors">Polityka prywatności</a></li>
                    <li><a href="/kontakt" class="hover:text-primary transition-colors">Kontakt</a></li>
                </ul>
            </div>
        </div>
    </div>
</footer>
