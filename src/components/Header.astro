---
import { Picture } from "astro:assets";

import IconHamburgerMenu from "@icons/hamburger-menu.svg";
import IconXMark from "@icons/x-mark.svg";

import LogoHorizontalBigTextColor from "@logos/horizontal-big-text/logo-horizontal-big-text-color.png";

const navigationLinks = [
    { href: "/o-mnie", label: "O mnie" },
    { href: "/uslugi", label: "Usługi" },
    { href: "/blog", label: "Z gabinetu psychodietetyka" },
    { href: "/kontakt", label: "Kontakt" }
];

const currentPath = Astro.url.pathname;
---

<header class="sidebar-closed bg-background/70 ease-drawer fixed top-0 right-0 left-0 z-50 backdrop-blur-md transition duration-300 data-hidden:-translate-y-full data-hidden:duration-400">
    <nav class="not-has-[+[data-open]]:border-border md:border-border border-b border-transparent transition duration-0 not-has-[+[data-open]]:delay-120">
        <div class="mx-auto flex max-w-6xl grid-cols-[1fr_auto_1fr] items-center px-6 py-3 md:grid">
            <div class="justify-self-start pr-20">
                <a href="/">
                    <Picture src={LogoHorizontalBigTextColor} formats={["webp", "avif"]} alt="Logo poradni Syl.VIA" loading="eager" fetchpriority="high" class="h-9 min-h-9 w-auto min-w-fit md:h-10" />
                </a>
            </div>

            <ul class="hidden items-center md:flex">
                {
                    navigationLinks.map((link) => (
                        <li>
                            <a href={link.href} class:list={["px-4 py-6 text-sm font-medium transition", currentPath === link.href ? "text-primary" : "text-muted-foreground hover:text-primary"]}>
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>

            <div class="grow md:hidden"></div>

            <div class="flex flex-col items-center justify-self-end">
                <button id="mobile-menu-toggle" class="group/menu-icon text-foreground relative cursor-pointer pr-1 md:hidden" aria-label="Rozwiń menu nawigacyjne" aria-controls="mobile-menu" aria-expanded="false">
                    <IconHamburgerMenu class="size-6 transition duration-200 group-aria-expanded/menu-icon:opacity-0" />
                    <IconXMark class="absolute inset-0 size-6 opacity-0 transition duration-150 group-aria-expanded/menu-icon:opacity-100 group-aria-expanded/menu-icon:duration-200" />
                </button>
            </div>
        </div>
    </nav>

    <nav id="mobile-menu" class="group/mobile-menu ease-drawer grid grid-rows-[0fr] overflow-hidden transition-[grid-template-rows] duration-400 data-open:grid-rows-[1fr] data-open:duration-300 md:hidden">
        <div class="group-data-open/mobile-menu:border-border overflow-hidden transition duration-0 group-not-data-open/mobile-menu:delay-100 group-data-open/mobile-menu:border-b">
            <ul class="flex flex-col gap-4 px-6 pt-2 pb-4">
                {
                    navigationLinks.map((link) => (
                        <li>
                            <a href={link.href} class:list={["-my-2 block leading-10 font-medium transition", currentPath === link.href ? "text-primary" : "text-muted-foreground hover:text-primary"]}>
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </nav>
</header>

<script>
    import onScroll from "@utils/scroll";

    const header = document.querySelector("header")!;
    const mobileMenuToggle = document.getElementById("mobile-menu-toggle")!;
    const mobileMenu = document.getElementById("mobile-menu")!;

    function setMenuOpen(openState: boolean) {
        if (openState) mobileMenu.setAttribute("data-open", "");
        else mobileMenu.removeAttribute("data-open");

        mobileMenuToggle.setAttribute("aria-expanded", String(openState));
    }

    function toggleMenu() {
        const nextOpenState = !mobileMenu.hasAttribute("data-open");
        setMenuOpen(nextOpenState);
    }

    mobileMenuToggle.addEventListener("click", toggleMenu);

    mobileMenu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            setMenuOpen(false);
        });
    });

    let lastScrollY = window.scrollY;
    onScroll((scrollY) => {
        if (scrollY > lastScrollY && scrollY > 100) {
            // scrolling down & past threshold - hide header and close mobile menu
            header.setAttribute("data-hidden", "");
            if (mobileMenu.hasAttribute("data-open")) {
                // make the animation of hiding the header slower if the menu is open,
                // so it doesn't feel almost instantaneous
                header.classList.add("duration-500!");
                setMenuOpen(false);
                header.addEventListener(
                    "transitionend",
                    () => {
                        header.classList.remove("duration-500!");
                    },
                    { once: true }
                );
            }
            setMenuOpen(false);
        } else {
            // scrolling up - show header
            header.removeAttribute("data-hidden");
        }
        lastScrollY = scrollY;
    });
</script>
