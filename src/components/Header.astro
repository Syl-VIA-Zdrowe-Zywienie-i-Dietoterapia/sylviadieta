---
import { Picture } from "astro:assets";

import IconHamburgerMenu from "@icons/hamburger-menu.svg";
import IconXMark from "@icons/x-mark.svg";

import LogoHorizontalBigTextColor from "@logos/horizontal-big-text/logo-horizontal-big-text-color.png";

const currentPath = Astro.url.pathname;
---

<header class="top-level-container bg-background/80 fixed top-0 right-0 left-0 z-50 backdrop-blur-md transition-transform duration-300">
    <nav class="not-has-[+[data-open]]:border-border md:border-border border-b border-transparent transition-[border-color] duration-0 not-has-[+[data-open]]:delay-100">
        <div class="mx-auto flex max-w-6xl grid-cols-[1fr_auto_1fr] items-center px-6 py-3 md:grid">
            <a href="/" class="justify-self-start">
                <Picture src={LogoHorizontalBigTextColor} formats={["avif"]} alt="Logo poradni Syl.VIA" loading="eager" fetchpriority="high" class="h-9 w-auto md:h-10" />
            </a>

            <ul class="hidden items-center gap-8 md:flex">
                <li><a href="/o-mnie" class:list={["text-sm font-medium transition-colors", currentPath === "/o-mnie" ? "text-primary" : "text-muted-foreground hover:text-primary"]}>O mnie</a></li>
                <li><a href="/uslugi" class:list={["text-sm font-medium transition-colors", currentPath === "/uslugi" ? "text-primary" : "text-muted-foreground hover:text-primary"]}>Usługi</a></li>
                <li><a href="/kontakt" class:list={["text-sm font-medium transition-colors", currentPath === "/kontakt" ? "text-primary" : "text-muted-foreground hover:text-primary"]}>Kontakt</a></li>
            </ul>

            <div class="grow md:hidden"></div>

            <div class="flex flex-col items-center justify-self-end">
                <button id="mobile-menu-toggle" class="group text-foreground relative cursor-pointer pr-1 md:hidden" aria-label="Rozwiń menu nawigacyjne" aria-controls="mobile-menu" aria-expanded="false">
                    <IconHamburgerMenu class="size-6 transition-opacity duration-200 group-aria-expanded:opacity-0" />
                    <IconXMark class="absolute inset-0 size-6 opacity-0 transition-opacity duration-150 group-aria-expanded:opacity-100 group-aria-expanded:duration-200" />
                </button>
            </div>
        </div>
    </nav>

    <nav id="mobile-menu" class="group grid grid-rows-[0fr] overflow-hidden transition-[grid-template-rows] duration-200 ease-out data-open:grid-rows-[1fr] md:hidden">
        <div class="group-data-open:border-border overflow-hidden border-b border-transparent transition-[border-color] duration-0 group-not-data-open:delay-100">
            <ul class="space-y-4 px-6 pt-2 pb-4">
                <li><a href="/o-mnie" class:list={["block font-medium transition-colors", currentPath === "/o-mnie" ? "text-primary" : "text-muted-foreground hover:text-primary"]}>O mnie</a></li>
                <li><a href="/uslugi" class:list={["block font-medium transition-colors", currentPath === "/uslugi" ? "text-primary" : "text-muted-foreground hover:text-primary"]}>Usługi</a></li>
                <li><a href="/kontakt" class:list={["block font-medium transition-colors", currentPath === "/kontakt" ? "text-primary" : "text-muted-foreground hover:text-primary"]}>Kontakt</a></li>
            </ul>
        </div>
    </nav>
</header>

<script>
    import { onScroll } from "../utils/scroll";

    function getHeaderElements() {
        const header = document.querySelector("header");
        const menuToggle = document.getElementById("mobile-menu-toggle");
        const menu = document.getElementById("mobile-menu");

        if (!header || !menuToggle || !menu) return null;
        return { header, menuToggle, menu };
    }

    const headerElements = getHeaderElements();
    if (!headerElements) throw new Error("[Header] Failed to find header elements.");
    const { header, menuToggle, menu } = headerElements;

    function setMenuOpen(isOpen: boolean) {
        if (isOpen) menu.setAttribute("data-open", "");
        else menu.removeAttribute("data-open");

        menuToggle.setAttribute("aria-expanded", String(isOpen));
    }

    function toggleMenu() {
        const nextOpenState = !menu.hasAttribute("data-open");
        setMenuOpen(nextOpenState);
    }

    menuToggle.addEventListener("click", toggleMenu);

    menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            setMenuOpen(false);
        });
    });

    let lastScrollY = window.scrollY;
    onScroll((scrollY) => {
        if (scrollY > lastScrollY && scrollY > 100) {
            // scrolling down & past threshold - hide header and close mobile menu
            header.classList.add("-translate-y-full");
            setMenuOpen(false);
        } else {
            // scrolling up - show header
            header.classList.remove("-translate-y-full");
        }
        lastScrollY = scrollY;
    });
</script>
