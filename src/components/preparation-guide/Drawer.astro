---
import Content from "./Content.astro";
---

<aside
    id="drawer"
    class="border-border bg-background ease-drawer fixed right-0 bottom-0 left-0 z-110 flex max-h-[80vh] translate-y-full flex-col overflow-y-auto rounded-t-2xl border-t shadow-xl transition duration-400 data-open:translate-y-0 md:hidden"
>
    <div id="drawer-handle" class="bg-background sticky top-0 flex cursor-grab justify-center py-3">
        <div class="bg-muted-foreground/40 h-1.5 w-12 rounded-full"></div>
    </div>
    <Content class="p-6 pt-2" />
</aside>

<div id="drawer-overlay" class="pointer-events-none fixed inset-0 z-100 bg-black/20 opacity-0 transition duration-400 data-visible:pointer-events-auto data-visible:opacity-100 md:hidden"></div>

<script>
    const drawer = document.getElementById("drawer")!;
    const drawerHandle = document.getElementById("drawer-handle")!;
    const drawerOverlay = document.getElementById("drawer-overlay")!;
    const toggle = document.getElementById("preparation-guide-toggle")!;

    function openDrawer() {
        drawer.setAttribute("data-open", "");
        drawerOverlay.setAttribute("data-visible", "");
        document.body.setAttribute("data-overlay-open", "");
        toggle.setAttribute("aria-expanded", "true");
    }

    function closeDrawer() {
        drawer.removeAttribute("data-open");
        drawerOverlay.removeAttribute("data-visible");
        document.body.removeAttribute("data-overlay-open");
        toggle.setAttribute("aria-expanded", "false");
    }

    function isDrawerOpen() {
        return drawer.hasAttribute("data-open");
    }

    toggle.addEventListener("click", () => (isDrawerOpen() ? closeDrawer() : openDrawer()));
    document.addEventListener("click", (event) => {
        if (!isDrawerOpen()) return;
        if (drawer.contains(event.target as Node) || toggle.contains(event.target as Node)) return;
        closeDrawer();
    });
    document.addEventListener("keydown", (event) => {
        if (!isDrawerOpen()) return;
        if (event.key === "Escape") closeDrawer();
    });

    let touchStartY = 0;
    let touchCurrentY = 0;
    let touchStartTime = 0;
    let isDragging = false;
    let startedOnHandle = false;
    let drawerHeight = 0;
    const VELOCITY_THRESHOLD = 0.4;

    drawer.addEventListener(
        "touchstart",
        (event) => {
            touchStartY = event.touches[0].clientY;
            touchCurrentY = touchStartY;
            touchStartTime = Date.now();
            isDragging = true;
            startedOnHandle = drawerHandle.contains(event.target as Node);
            drawerHeight = drawer.getBoundingClientRect().height || window.innerHeight * 0.85;
            drawer.style.transition = "none";
        },
        { passive: true }
    );

    drawer.addEventListener(
        "touchmove",
        (event) => {
            if (!isDragging) return;
            touchCurrentY = event.touches[0].clientY;
            const deltaY = touchCurrentY - touchStartY;
            const isScrolledToTop = drawer.scrollTop <= 0;

            if (isDrawerOpen() && (startedOnHandle || isScrolledToTop) && deltaY > 0) {
                event.preventDefault();
                drawer.style.transform = `translateY(${deltaY}px)`;
            }
        },
        { passive: false }
    );

    drawer.addEventListener("touchend", () => {
        if (!isDragging) return;
        isDragging = false;
        drawer.style.transition = "";
        drawer.style.transform = "";

        const deltaY = touchCurrentY - touchStartY;
        const velocity = Math.abs(deltaY) / Math.max(Date.now() - touchStartTime, 1);
        const visiblePercent = isDrawerOpen() ? 100 - (Math.abs(deltaY) / drawerHeight) * 100 : (Math.abs(deltaY) / drawerHeight) * 100;
        const isScrolledToTop = drawer.scrollTop <= 0;

        const canDismiss = startedOnHandle || isScrolledToTop;
        if (isDrawerOpen() && canDismiss && (visiblePercent < 50 || (deltaY > 0 && velocity > VELOCITY_THRESHOLD))) {
            closeDrawer();
        }
    });
</script>
