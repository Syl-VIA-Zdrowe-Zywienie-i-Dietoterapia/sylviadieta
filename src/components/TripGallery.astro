---
import { Picture } from "astro:assets";

import IconArchive from "@icons/archive.svg";
import IconXMark from "@icons/x-mark.svg";

import ImageTripFeatured from "@images/workshops-and-trips/trip-featured.jpg";
import ImageTrip1 from "@images/workshops-and-trips/trip1.png";
import ImageTrip2 from "@images/workshops-and-trips/trip2.png";
import ImageTrip3 from "@images/workshops-and-trips/trip3.png";

const featuredTrip = {
    id: "wyróżniony-wyjazd-10-2025",
    title: "Wyrózniony wyjazd | 10.2025",
    image: ImageTripFeatured,
    active: false
};
const badgeProps = featuredTrip.active
    ? {
          label: "Trwa rekrutacja",
          badgeClass: "bg-success text-white",
          dotClass: "bg-white",
          ping: true
      }
    : {
          label: "Wyjazd zakończony",
          badgeClass: "bg-muted text-muted-foreground",
          dotClass: "bg-muted-foreground",
          ping: false
      };

const archivedTrips = [
    // {
    //     id: "przeszły-wyjazd-10-2025",
    //     title: "Przeszły wyjazd | 10.2025",
    //     image: ImageTripFeatured
    // },
    {
        id: "przeszły-wyjazd-04-2025",
        title: "Przeszły wyjazd | 04.2025",
        image: ImageTrip1
    },
    {
        id: "przeszły-wyjazd-03-2025",
        title: "Przeszły wyjazd | 03.2025",
        image: ImageTrip2
    },
    {
        id: "przeszły-wyjazd-12-2024",
        title: "Przeszły wyjazd | 12.2024",
        image: ImageTrip3
    }
];

const { class: wrapperClass = "" } = Astro.props;
---

<div class:list={["space-y-8 md:space-y-12", wrapperClass]}>
    <div class="relative mx-auto max-w-4xl px-4 md:px-6">
        <div class:list={["absolute -top-3.5 left-6.5 z-10 rounded-full px-3.5 py-1.5 text-sm font-semibold shadow-lg md:left-10", badgeProps.badgeClass]}>
            <span class="flex items-center gap-2">
                <span class="relative flex size-2">
                    {badgeProps.ping && <span class="absolute size-full animate-ping rounded-full bg-white opacity-75" />}
                    <span class:list={["size-full rounded-full", badgeProps.dotClass]}></span>
                </span>
                <span class="-mt-px">{badgeProps.label}</span>
            </span>
        </div>

        <button
            type="button"
            class="keyboard-focusable w-full cursor-zoom-in rounded-xl shadow-md transition hover:shadow-xl"
            data-trip
            data-trip-id={featuredTrip.id}
            data-trip-title={featuredTrip.title}
            aria-label={`Powiększ obraz: ${featuredTrip.title}`}
        >
            <Picture src={featuredTrip.image} alt={featuredTrip.title} formats={["webp", "avif"]} class="w-full rounded-xl" />
        </button>
    </div>

    {
        archivedTrips.length > 0 && (
            <div class="space-y-1 px-4 md:space-y-4">
                <div class="text-muted-foreground flex items-center justify-center gap-3">
                    <IconArchive class="size-5.5 md:size-6" />
                    <h4 class="md:text-1.5xl -mt-0.5 font-serif text-xl font-semibold">Archiwum wyjazdów</h4>
                </div>
                <div class="swiper -mx-10 overflow-hidden py-2 md:-mx-2 md:px-4 md:pb-6">
                    <div class="swiper-wrapper box-content flex">
                        {archivedTrips.map((trip) => (
                            <div class="swiper-slide w-auto shrink-0">
                                <button
                                    type="button"
                                    class="keyboard-focusable xs:h-60 h-50 max-w-[90vw] cursor-[inherit] rounded-lg sm:h-70 md:h-80 lg:h-90"
                                    data-trip
                                    data-trip-id={trip.id}
                                    data-trip-title={trip.title}
                                    aria-label={`Powiększ obraz: ${trip.title}`}
                                >
                                    <Picture src={trip.image} alt={trip.title} formats={["webp", "avif"]} class="h-full w-auto rounded-lg object-contain shadow-md transition hover:shadow-lg" />
                                </button>
                            </div>
                        ))}
                    </div>

                    <div class="swiper-pagination mt-3 flex items-center justify-center gap-2 md:hidden" />
                </div>
            </div>
        )
    }
</div>

<dialog data-lightbox-modal class="top-level-container pointer-events-none fixed inset-0 flex size-full max-h-screen max-w-screen items-center justify-center bg-transparent backdrop:bg-transparent open:pointer-events-auto">
    <div data-lightbox-content class="group/content relative">
        <button
            type="button"
            class="group/close keyboard-focusable absolute -top-3 -right-3 z-10 flex cursor-pointer rounded-full bg-white/80 p-1.5 text-black opacity-0 shadow-lg transition group-data-visible/content:opacity-100 hover:scale-110 hover:bg-white"
            aria-label="Zamknij podgląd"
        >
            <IconXMark class="size-5 transition group-hover/close:scale-120" />
        </button>
        <div data-lightbox-picture-container class="opacity-0 transition group-data-visible/content:opacity-100 group-data-visible/content:transition-none"></div>
    </div>
</dialog>

<div data-lightbox-overlay class="pointer-events-none fixed inset-0 z-100 bg-black/90 opacity-0 transition duration-400 ease-out data-visible:opacity-100"></div>

<script>
    import Swiper from "swiper";
    import { Mousewheel, Pagination } from "swiper/modules";

    const swiperContainer = document.querySelector<HTMLElement>(".swiper")!;
    const swiper = new Swiper(swiperContainer, {
        modules: [Mousewheel, Pagination],

        centeredSlides: true,
        grabCursor: true,
        observer: true,
        observeParents: true,
        observeSlideChildren: true,
        slidesPerView: "auto",
        spaceBetween: 16,
        touchEventsTarget: "container",

        mousewheel: {
            forceToAxis: true
        },
        pagination: {
            enabled: true,
            el: ".swiper-pagination",

            clickable: true,

            renderBullet: (index, className) =>
                `<button class="${className} keyboard-focusable swiper-pagination-bullet-${index} bg-muted-foreground/30 hover:cursor-pointer hover:bg-primary size-2 rounded-full transition-all duration-300 [&.swiper-pagination-bullet-active]:bg-primary [&.swiper-pagination-bullet-active]:w-6" aria-label="Przejdź do slajdu ${index + 1}"></button>`
        },

        breakpoints: {
            768: {
                centeredSlidesBounds: true,
                pagination: false,
                spaceBetween: 20
            }
        }
    });

    requestAnimationFrame(() => {
        swiper.update();
        swiper.slideTo(0, 0, false);
    });

    const swiperSlides = document.querySelectorAll<HTMLElement>(".swiper-slide");
    swiperSlides.forEach((slide, index) => {
        const button = slide.querySelector("button")!;
        button.addEventListener("focusin", () => {
            swiper.slideTo(index);
        });
    });

    const lightboxModal = document.querySelector<HTMLDialogElement>("[data-lightbox-modal]")!;
    const lightboxContent = lightboxModal.querySelector<HTMLElement>("[data-lightbox-content]")!;
    const lightboxPictureContainer = lightboxModal.querySelector<HTMLElement>("[data-lightbox-picture-container]")!;
    const lightboxOverlay = document.querySelector<HTMLDivElement>("[data-lightbox-overlay]")!;

    let isAnimating = false;

    const LIGHTBOX_MAX_WIDTH = 1152; // w-6xl = 1152px [tailwind]
    const LIGHTBOX_VIEWPORT_MARGIN = 0.9;
    const LIGHTBOX_TRANSITION_DURATION = 400;

    function calculateLightboxRect(imageRatio: number): { width: number; height: number; top: number; left: number } {
        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight;
        const maxWidth = Math.min(LIGHTBOX_MAX_WIDTH, viewportWidth * LIGHTBOX_VIEWPORT_MARGIN);
        const maxHeight = viewportHeight * LIGHTBOX_VIEWPORT_MARGIN;

        let width: number;
        let height: number;
        if (imageRatio > maxWidth / maxHeight) {
            width = maxWidth;
            height = width / imageRatio;
        } else {
            height = maxHeight;
            width = height * imageRatio;
        }

        const top = (viewportHeight - height) / 2;
        const left = (viewportWidth - width) / 2;

        return { width, height, top, left };
    }

    function assignClonePosition(clone: HTMLElement, position: { top: number; left: number; width: number; height: number }) {
        Object.assign(clone.style, {
            transition: `all ${LIGHTBOX_TRANSITION_DURATION}ms var(--ease-out)`,
            top: `${position.top}px`,
            left: `${position.left}px`,
            width: `${position.width}px`,
            height: `${position.height}px`
        });
    }

    function openLightboxModal(originalPicture: HTMLPictureElement): void {
        if (isAnimating) return;
        isAnimating = true;

        const originalImage = originalPicture.querySelector("img")!;
        const originalImageRect = originalImage.getBoundingClientRect();
        const originalImageSrc = originalImage.src;

        const pictureClone = originalPicture.cloneNode(true) as HTMLPictureElement;
        Object.assign(pictureClone.style, {
            position: "fixed",
            top: `${originalImageRect.top}px`,
            left: `${originalImageRect.left}px`,
            width: `${originalImageRect.width}px`,
            height: `${originalImageRect.height}px`,
            pointerEvents: "none"
        });
        lightboxModal.appendChild(pictureClone);

        const temporaryImage = new Image();
        temporaryImage.src = originalImageSrc;
        temporaryImage.onload = () => {
            const imageRatio = temporaryImage.naturalWidth / temporaryImage.naturalHeight;
            const { width, height, top, left } = calculateLightboxRect(imageRatio);

            Object.assign(lightboxPictureContainer.style, {
                width: `${width}px`,
                height: `${height}px`
            });

            const finalPicture = originalPicture.cloneNode(true) as HTMLPictureElement;
            lightboxPictureContainer.appendChild(finalPicture);

            lightboxModal.showModal();
            document.body.setAttribute("data-overlay-open", "");
            requestAnimationFrame(() => {
                lightboxOverlay.setAttribute("data-visible", "");
                assignClonePosition(pictureClone, { width, height, top, left });
            });

            setTimeout(() => {
                lightboxContent.setAttribute("data-visible", "");
                pictureClone.remove();
                isAnimating = false;
            }, LIGHTBOX_TRANSITION_DURATION);
        };
    }

    function closeLightboxModal() {
        if (isAnimating) return;
        isAnimating = true;

        requestAnimationFrame(() => {
            lightboxOverlay.removeAttribute("data-visible");
        });
        lightboxContent.removeAttribute("data-visible");
        document.body.removeAttribute("data-overlay-open");

        setTimeout(() => {
            lightboxModal.close();
            lightboxPictureContainer.innerHTML = "";
            isAnimating = false;
        }, LIGHTBOX_TRANSITION_DURATION / 2);
    }

    lightboxModal.addEventListener("cancel", (event) => {
        event.preventDefault();
        closeLightboxModal();
    });
    document.addEventListener("click", (event) => {
        if (!lightboxModal.open) return;
        if (lightboxPictureContainer.contains(event.target as Node)) return; // this handles the close button as well since it is outside the picture container
        closeLightboxModal();
    });

    const tripButtons = document.querySelectorAll<HTMLButtonElement>("[data-trip]");
    tripButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const tripPicture = button.querySelector("picture")!;
            openLightboxModal(tripPicture);
        });
    });
</script>
