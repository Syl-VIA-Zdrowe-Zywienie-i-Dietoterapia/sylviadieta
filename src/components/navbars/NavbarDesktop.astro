---
import { Picture } from "astro:assets";
import logoWhiteTransparent from "../../images/logo-white-transparent.png";

const pathname = Astro.url.pathname;
---

<nav class="navbar mx-auto w-full max-w-6xl py-4 hidden lg:flex">
    <a href="/" class="navbar-start w-fit">
        <Picture src={logoWhiteTransparent} formats={['avif']} alt="logo" loading="eager" class="h-auto w-24 lg:w-28" />
    </a>

    <div class="navbar-center ml-6">
        <ul class="menu menu-horizontal gap-2 px-4 text-2xl font-bold transition-colors xl:gap-4">
            <li>
                <a href="/o-mnie" class:list={[
                    "hover:bg-neutral/20 active:bg-neutral/20 hover:shadow-sm active:text-current active:shadow-sm",
                    pathname.startsWith("/o-mnie") && "bg-base-100! text-base-content shadow-sm"
                ]}> O mnie </a>
            </li>
            <li>
                <a href="/uslugi" class:list={[
                    "hover:bg-neutral/20 active:bg-neutral/20 hover:shadow-sm active:text-current active:shadow-sm",
                    pathname.startsWith("/uslugi") && "bg-base-100! text-base-content shadow-sm"
                ]}> Usługi </a>
            </li>
            <li>
                <a href="/blog" class:list={[
                    "hover:bg-neutral/20 active:bg-neutral/20 hover:shadow-sm active:text-current active:shadow-sm",
                    pathname.startsWith("/blog") && "bg-base-100! text-base-content shadow-sm"
                ]}> Z gabinetu psychodietetyka </a>
            </li>
            <li>
                <a href="/kontakt" class:list={[
                    "hover:bg-neutral/20 active:bg-neutral/20 hover:shadow-sm active:text-current active:shadow-sm",
                    pathname.startsWith("/kontakt") && "bg-base-100! text-base-content shadow-sm"
                ]}> Kontakt </a>
            </li>
        </ul>
    </div>
</nav>
