---
interface Props {
    tooltipId?: string;
    placement?: "top" | "right" | "bottom" | "left";
    triggerTabIndex?: number;
    triggerClass?: string;
    tooltipClass?: string;
}

const { tooltipId = `tooltip-${crypto.randomUUID()}`, placement = "top", triggerTabIndex = 0, triggerClass = "", tooltipClass = "" } = Astro.props;
---

<span data-tooltip data-tooltip-placement={placement} class="relative inline-block">
    <span data-tooltip-trigger aria-describedby={tooltipId} class={triggerClass} tabindex={triggerTabIndex}>
        <slot name="trigger" />
    </span>

    <span
        id={tooltipId}
        data-tooltip-box
        role="tooltip"
        class:list={[
            "bg-muted-foreground/99 invisible fixed w-48 scale-95 rounded-lg px-3 pt-2 pb-2.5 text-center text-sm text-white opacity-0 shadow-lg transition duration-200 ease-out will-change-[transform,scale,opacity] before:absolute before:-inset-2 before:-z-10 before:content-['']",
            tooltipClass
        ]}
    >
        <slot name="content" />
        <span data-tooltip-arrow aria-hidden="true" class="bg-muted-foreground absolute size-4 [clip-path:polygon(0_0,100%_0,100%_100%)]"></span>
    </span>
</span>

<script>
    import { arrow, autoUpdate, computePosition, flip, offset, shift } from "@floating-ui/dom";

    const tooltips = document.querySelectorAll<HTMLElement>("[data-tooltip]");

    tooltips.forEach((tooltip) => {
        const tooltipTrigger = tooltip.querySelector<HTMLElement>("[data-tooltip-trigger]")!;
        const tooltipBox = tooltip.querySelector<HTMLElement>("[data-tooltip-box]")!;
        const tooltipArrow = tooltip.querySelector<HTMLElement>("[data-tooltip-arrow]")!;

        const preferredPlacement = (tooltip.dataset.tooltipPlacement as "top" | "right" | "bottom" | "left") || "top";

        let showTimeout: ReturnType<typeof setTimeout> | null = null;
        let hideTimeout: ReturnType<typeof setTimeout> | null = null;
        let isHiding = false;
        let stopAutoUpdate: (() => void) | null = null;

        async function updatePosition() {
            const { x, y, placement, middlewareData } = await computePosition(tooltipTrigger, tooltipBox, {
                placement: preferredPlacement,
                strategy: "fixed",
                middleware: [offset(8), flip(), shift({ padding: 8 }), arrow({ element: tooltipArrow })]
            });

            const tooltipTransformOrigin: Record<string, string> = {
                left: "right center",
                right: "left center",
                top: "center bottom",
                bottom: "center top"
            };

            const tooltipArrowPlacement: Record<string, string> = {
                top: "bottom",
                right: "left",
                bottom: "top",
                left: "right"
            };

            const tooltipArrowRotation: Record<string, number> = {
                left: 45,
                right: 225,
                top: 135,
                bottom: 315
            };

            Object.assign(tooltipBox.style, {
                left: `${x}px`,
                top: `${y}px`,
                transformOrigin: tooltipTransformOrigin[placement]
            });

            Object.assign(tooltipArrow.style, {
                left: middlewareData.arrow?.x != null ? `${middlewareData.arrow?.x}px` : "",
                top: middlewareData.arrow?.y != null ? `${middlewareData.arrow?.y}px` : "",
                right: "",
                bottom: "",
                [tooltipArrowPlacement[placement]]: "-4px",
                transform: `rotate(${tooltipArrowRotation[placement]}deg)`
            });
        }

        function showTooltip(delay = 0) {
            isHiding = false;
            if (hideTimeout) {
                clearTimeout(hideTimeout);
                hideTimeout = null;
            }
            if (showTimeout) clearTimeout(showTimeout);
            showTimeout = setTimeout(async () => {
                stopAutoUpdate?.();
                await updatePosition();
                stopAutoUpdate = autoUpdate(tooltipTrigger, tooltipBox, updatePosition);
                tooltipBox.classList.remove("invisible");
                requestAnimationFrame(() => {
                    tooltipBox.classList.remove("opacity-0", "scale-95");
                });
            }, delay);
        }

        function hideTooltip(delay = 0) {
            if (showTimeout) {
                clearTimeout(showTimeout);
                showTimeout = null;
            }
            hideTimeout = setTimeout(() => {
                isHiding = true;
                tooltipBox.classList.add("opacity-0", "scale-95");
                tooltipBox.addEventListener(
                    "transitionend",
                    () => {
                        if (isHiding) {
                            tooltipBox.classList.add("invisible");
                            stopAutoUpdate?.();
                            stopAutoUpdate = null;
                        }
                    },
                    { once: true }
                );
            }, delay);
        }

        const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        let suppressNextBlur = false;

        if (canHover) {
            tooltipTrigger.addEventListener("mouseenter", () => showTooltip(300));
            tooltipTrigger.addEventListener("mouseleave", () => hideTooltip(100));
            tooltipBox.addEventListener("mouseenter", () => showTooltip());
            tooltipBox.addEventListener("mouseleave", () => hideTooltip(100));
        } else {
            tooltipBox.addEventListener("pointerdown", () => {
                suppressNextBlur = true;
            });
        }

        tooltipTrigger.addEventListener("focus", () => showTooltip());
        tooltipTrigger.addEventListener("blur", () => {
            if (suppressNextBlur) {
                suppressNextBlur = false;
                tooltipTrigger.focus({ preventScroll: true });
                return;
            }
            hideTooltip();
        });
    });
</script>
